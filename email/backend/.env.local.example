# Minimal setup for testing on your own PC.   Copy this file to  backend/.env  and fill the 4 Gmail lines.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./email_intelligence.db
AUTO_CREATE_TABLES=true
SECRET_KEY=any-long-random-text-for-local-testing-0123456789
FIRST_USER_IS_ADMIN=true
PROCESSING_MODE=background
LLM_PROVIDER=heuristic          # works without any AI key; put a Gemini/OpenAI key later if you want

# Gmail: Security -> 2-Step Verification -> App passwords. Also enable IMAP in Gmail settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your-16-letter-app-password
SEND_REPLIES_VIA_SMTP=true

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=yourname@gmail.com
IMAP_PASSWORD=your-16-letter-app-password
IMAP_SYNC_INTERVAL_SECONDS=30
IMAP_SINCE_DAYS=3

# If check_mail.py times out on the TLS handshake: auto tries normal TLS, then TLS 1.2 only. Alternatives: default | tls12.
# SMTP_PORT=465 (instead of 587) is also supported.
MAIL_TLS_MODE=auto
MAIL_NET_TIMEOUT_SECONDS=15
