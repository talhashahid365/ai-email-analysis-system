# ─────────────────────────────────────────────────────────────────────────────
# MailNexa AI — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
PROJECT_NAME=MailNexa AI
ENVIRONMENT=development        # development | staging | production | test
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
VERSION=2.1.0

# ── Database ──────────────────────────────────────────────────────────────────
# Production: use PostgreSQL. SQLite is for local dev only.
DATABASE_URL=postgresql://mailnexa:mailnexa_secret@localhost:5432/mailnexa

# Local development only (SQLite):
# DATABASE_URL=sqlite:///./email_intelligence.db

# Set to False in production — use `alembic upgrade head` instead
AUTO_CREATE_TABLES=true

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_use_python_secrets_token_hex_32

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours
RESET_TOKEN_EXPIRE_MINUTES=30
VERIFY_TOKEN_EXPIRE_MINUTES=4320   # 72 hours

# MUST be False in production
EXPOSE_DEV_TOKENS=true

# When true, new users must click the emailed link before logging in. Requires SMTP_* below to be set;
# without SMTP the link is only printed to the server console. Recommended true in production.
REQUIRE_EMAIL_VERIFICATION=false

ALLOW_REGISTRATION=true
FIRST_USER_IS_ADMIN=true
# Comma-separated emails that always get admin role:
ADMIN_EMAILS=
PASSWORD_MIN_LENGTH=8

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Redis ─────────────────────────────────────────────────────────────────────
# Required in production for distributed rate limiting and Celery.
# Leave empty to use in-memory rate limiting (local dev only).
REDIS_URL=redis://localhost:6379/0

# ── Error Tracking (Sentry) ───────────────────────────────────────────────────
# Get your DSN from https://sentry.io — leave empty to disable
SENTRY_DSN=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MIN=10       # login, register, password reset
AI_RATE_LIMIT_PER_MIN=30         # AI analysis, smart reply, assistant
UPLOAD_RATE_LIMIT_PER_MIN=20     # email uploads

# ── LLM APIs (optional — app works without them using heuristic engine) ────────
# Provider selection: auto | gemini | openai | anthropic | heuristic
LLM_PROVIDER=auto
AI_FALLBACK_TO_HEURISTIC=true

GEMINI_API_KEY=
# gemini-2.0-flash was shut down by Google on 2026-06-01. Use a current model:
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2

# ── Background Processing ─────────────────────────────────────────────────────
# sync: process in request (slow, for dev)
# background: asyncio background task (fast, single-server)
# celery: distributed (requires Redis + Celery worker)
PROCESSING_MODE=background

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Used for sending verification and password reset emails.
# PASSWORD RESET WORKS ONLY BY EMAIL: the reset link is never shown in the app or the console,
# so SMTP must be configured or nobody can reset a forgotten password.
# Gmail: turn on 2-Step Verification, create an "App password" at
#   https://myaccount.google.com/apppasswords  and use it as SMTP_PASSWORD (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mailnexa.ai

# Approve & Transmit e-mails the reply to the original sender through the SMTP account above (set false to only record).
SEND_REPLIES_VIA_SMTP=true

# ── IMAP (real incoming mail) ─────────────────────────────────────────────────
# Lets the "Sync Mailbox" button in the Inbox pull real e-mail. Gmail: enable IMAP in Gmail settings and use the
# same App Password as above. Mail sent by IMAP_USER itself is ignored (it is your own outgoing mail).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_MAX_FETCH=25
# Automatic check of the mailbox (seconds). New customer mail and follow-up replies then appear on the website by themselves.
IMAP_SYNC_INTERVAL_SECONDS=30
# Only mail from the last N days is imported (keeps an old mailbox from flooding the website).
IMAP_SINCE_DAYS=3
# Website account that owns the mail. Empty = the account with the IMAP_USER address, otherwise the first admin.
IMAP_OWNER_EMAIL=

# ── Email Handling ────────────────────────────────────────────────────────────
THREAD_MATCH_DAYS=90
REPLY_OVERDUE_HOURS=24
DEADLINE_NOTICE_DAYS=2
DEADLINE_CHECK_INTERVAL_SECONDS=3600
MAX_PAGE_SIZE=200
MAX_PROCESSING_RETRIES=3
MAX_UPLOAD_BYTES=2000000
MAX_IMPORT_ROWS=500
MAX_BODY_CHARS=50000

# If check_mail.py times out on the TLS handshake: auto tries normal TLS, then TLS 1.2 only. Alternatives: default | tls12.
# SMTP_PORT=465 (instead of 587) is also supported.
MAIL_TLS_MODE=auto
MAIL_NET_TIMEOUT_SECONDS=15
